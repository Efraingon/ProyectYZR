# Supabase Configuration
# These variables are required for the application to connect to your Supabase project.

NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Optional: For server-side usage (keep this secret!)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Application Settings
NEXT_PUBLIC_APP_NAME=ProyectYZR
NEXT_PUBLIC_DEMO_USER_EMAIL=demo@proyectos.local

# Secret used to sign the session cookie (HMAC-SHA256)
AUTH_SECRET=change-me-in-production